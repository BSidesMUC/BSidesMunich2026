#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "net/http"
require "time"
require "optparse"
require "tempfile"
require "uri"
require "yaml"

EVENT = "bsides-munich-2026"
EXPORT_URL = "https://pretalx.com/#{EVENT}/schedule/export/schedule.json"
EXPECTED_TITLE = "BSides Munich 2026"
WORKSHOP_DATE = "2026-11-07"
CONFERENCE_DATE = "2026-11-09"
WORKSHOP_ROOM_PREFIX = "Hochschule München - "
# Hidden from the website agenda and speaker list, even if still listed in Pretalx.
HIDDEN_WORKSHOP_CODES = %w[BRNBXA PTU9TZ 9TQD99].freeze
CANCELED_SESSION_CODES = {
  "XHX7KN" => "TBD",
  "BPFZJK" => "TBD"
}.freeze
# Program items that are not (yet) in Pretalx; skipped once Pretalx lists a slot with the same title.
# Placeholders below give way once Pretalx lists a real session (e.g. a keynote) in the same time slot.
# Keynotes are plain talks in Pretalx; they are labelled here by session code.
KEYNOTE_LABELS = {
  "YUEPSB" => "Opening Keynote",
  "9QBG3B" => "Closing Keynote"
}.freeze
MANUAL_CONFERENCE_BREAKS = [
  { "time" => "09:00–09:10", "break" => "Opening Ceremony", "rooms" => ["munich"], "featured" => true },
  { "time" => "17:25–17:55", "break" => "Closing Keynote", "rooms" => ["munich"], "featured" => true },
  { "time" => "17:55–18:00", "break" => "Closing Ceremony", "rooms" => ["munich"], "featured" => true }
].freeze
WIDGET_URL = "https://pretalx.com/#{EVENT}/schedule/widget/v2.json"
# Pretalx break slots that are not worth showing on the website.
IGNORED_BREAK_TITLES = ["Room change"].freeze
# Pretalx pins these to one room, but they happen at the front desk and apply to everyone.
VENUE_WIDE_BREAK_TITLES = ["Registration"].freeze
CONFERENCE_ROOMS = {
  "Westin - Partenkirchen" => "partenkirchen",
  "Westin - Munich" => "munich"
}.freeze

options = { check: false, source: nil }
OptionParser.new do |parser|
  parser.banner = "Usage: scripts/sync-pretalx [--check] [--source FILE]"
  parser.on("--check", "Validate and report changes without writing files") { options[:check] = true }
  parser.on("--source FILE", "Use a local Pretalx export instead of downloading") { |file| options[:source] = file }
end.parse!

def abort_sync(message)
  warn "Pretalx sync aborted: #{message}"
  exit 2
end

def fetch_export(url)
  uri = URI(url)
  request = Net::HTTP::Get.new(uri)
  request["User-Agent"] = "BSidesMunich2026 schedule sync"

  response = Net::HTTP.start(
    uri.host,
    uri.port,
    use_ssl: true,
    open_timeout: 10,
    read_timeout: 30
  ) { |http| http.request(request) }

  abort_sync("download failed with HTTP #{response.code}") unless response.is_a?(Net::HTTPSuccess)
  response.body
rescue StandardError => e
  abort_sync("download failed: #{e.message}")
end

def sessions_for(day)
  day.fetch("rooms").flat_map do |room, sessions|
    sessions.map { |session| session.merge("source_room" => room) }
  end
end

def pretalx_day(conference, date)
  conference.fetch("days").find { |day| day["date"] == date } ||
    abort_sync("expected schedule day #{date} is missing")
end

def break_slots(widget, date)
  rooms = widget.fetch("rooms").to_h { |room| [room["id"], room.dig("name", "en")] }
  widget.fetch("talks")
    .select { |talk| talk["slot_type"] == "break" }
    .map do |talk|
      start = Time.parse(talk.fetch("start")).getlocal("+01:00")
      finish = Time.parse(talk.fetch("end")).getlocal("+01:00")
      { "date" => start.strftime("%Y-%m-%d"), "start" => start.strftime("%H:%M"), "end" => finish.strftime("%H:%M"),
        "title" => talk.dig("title", "en"), "room" => rooms[talk["room"]] }
    end
    .select { |slot| slot["date"] == date && !IGNORED_BREAK_TITLES.include?(slot["title"]) }
    .group_by { |slot| slot.values_at("start", "end", "title") }
    .map do |_key, group|
      slot = group.first.reject { |key, _| key == "room" }
      conference_rooms = group.map { |entry| CONFERENCE_ROOMS[entry["room"]] }.compact.uniq
      # Breaks that only exist in some conference rooms are shown in those rooms' columns only.
      slot["rooms"] = conference_rooms if conference_rooms.any? && conference_rooms.length < CONFERENCE_ROOMS.length &&
                                !VENUE_WIDE_BREAK_TITLES.include?(slot["title"])
      slot
    end
    .sort_by { |slot| slot["start"] }
end

raw = options[:source] ? File.read(options[:source]) : fetch_export(EXPORT_URL)
export = JSON.parse(raw)
widget = JSON.parse(fetch_export(WIDGET_URL))
conference = export.dig("schedule", "conference") || abort_sync("conference data is missing")

abort_sync("unexpected event acronym #{conference['acronym'].inspect}") unless conference["acronym"] == EVENT
abort_sync("unexpected conference title #{conference['title'].inspect}") unless conference["title"] == EXPECTED_TITLE

workshop_sessions = sessions_for(pretalx_day(conference, WORKSHOP_DATE))
  .select { |session| session["track"] == "Workshops" }
  .reject { |session| HIDDEN_WORKSHOP_CODES.include?(session.fetch("code")) }
  .sort_by { |session| [session.fetch("start"), session.fetch("source_room"), session.fetch("title")] }

conference_sessions = sessions_for(pretalx_day(conference, CONFERENCE_DATE))
  .select { |session| session["track"] == "Talks" }
  .reject { |session| CANCELED_SESSION_CODES.key?(session.fetch("code")) }

abort_sync("no workshops found") if workshop_sessions.empty?
abort_sync("no conference talks found") if conference_sessions.empty?

unknown_rooms = conference_sessions.map { |session| session["source_room"] }.uniq - CONFERENCE_ROOMS.keys
abort_sync("unknown conference room(s): #{unknown_rooms.join(', ')}") unless unknown_rooms.empty?

all_sessions = workshop_sessions + conference_sessions
sessions_without_people = all_sessions.select { |session| session.fetch("persons", []).empty? }
unless sessions_without_people.empty?
  abort_sync("sessions without speakers: #{sessions_without_people.map { |session| session['code'] }.join(', ')}")
end

agenda = {
  "workshops" => workshop_sessions.map do |session|
    workshop = {
      "time" => "#{session.fetch('start')}–#{session.fetch('end')[11, 5]}",
      "room" => session.fetch("source_room").delete_prefix(WORKSHOP_ROOM_PREFIX),
      "title" => session.fetch("title"),
      "speakers" => session.fetch("persons").map { |person| person.fetch("public_name") }.join(" & "),
      "code" => session.fetch("code")
    }
    workshop
  end,
  "conference" => conference_sessions.group_by { |session| [session.fetch("start"), session.fetch("end")[11, 5]] }
    .sort_by { |(start, _end), _sessions| start }
    .map do |(start, finish), slot_sessions|
      slot = { "time" => "#{start}–#{finish}" }
      slot_sessions.each do |session|
        room_key = CONFERENCE_ROOMS.fetch(session.fetch("source_room"))
        abort_sync("duplicate session in #{room_key} at #{start}") if slot.key?(room_key)
        slot[room_key] = {
          "title" => session.fetch("title"),
          "speakers" => session.fetch("persons").map { |person| person.fetch("public_name") }.join(" & "),
          "code" => session.fetch("code")
        }
        slot[room_key]["rookie"] = true if session.fetch("type").include?("Rookie")
      end
      CANCELED_SESSION_CODES.each do |code, title|
        canceled = sessions_for(pretalx_day(conference, CONFERENCE_DATE)).find { |session| session["code"] == code }
        next unless canceled && canceled["start"] == start

        room_key = CONFERENCE_ROOMS.fetch(canceled.fetch("source_room"))
        abort_sync("duplicate session in #{room_key} at #{start}") if slot.key?(room_key)
        slot[room_key] = { "title" => title, "placeholder" => true }
      end
      # A session alone in its slot (keynotes) runs in one room only; every other slot needs both rooms.
      session_rooms = CONFERENCE_ROOMS.values & slot.keys
      if session_rooms.length == 1
        keynote = slot[session_rooms.first]
        keynote["keynote"] = KEYNOTE_LABELS.fetch(keynote.fetch("code")) { abort_sync("unlabelled single-room session #{keynote['code']}") }
      elsif session_rooms.length < CONFERENCE_ROOMS.length
        abort_sync("missing room at #{start}: #{(CONFERENCE_ROOMS.values - slot.keys).join(', ')}")
      end
      slot
    end
    .concat(break_slots(widget, CONFERENCE_DATE).map { |slot| { "time" => "#{slot['start']}–#{slot['end']}", "break" => slot["title"], "rooms" => slot["rooms"], "featured" => (true unless slot["title"].match?(/break/i)) }.compact })
    .then { |slots| slots + MANUAL_CONFERENCE_BREAKS.reject { |manual| slots.any? { |slot| slot["break"] == manual["break"] } } }
    .then { |slots| slots.reject { |slot| slot["break"] && slots.any? { |other| !other["break"] && other["time"] == slot["time"] } } }
    .sort_by { |slot| slot.fetch("time") },
  "workshop_breaks" => break_slots(widget, WORKSHOP_DATE).map { |slot| { "time" => "#{slot['start']}–#{slot['end']}", "break" => slot["title"] } }
}

speaker_entries = all_sessions.flat_map do |session|
  session.fetch("persons").map do |person|
    {
      "code" => person.fetch("code"),
      "name" => person.fetch("public_name"),
      "avatar" => person["avatar"],
      "biography" => person["biography"] || "",
      "profile_url" => person.fetch("url"),
      "session" => {
        "title" => session.fetch("title"),
        "url" => session.fetch("url"),
        "type" => session.fetch("type")
      }
    }
  end
end

speakers = speaker_entries.group_by { |entry| entry.fetch("code") }.map do |code, entries|
  %w[name avatar biography profile_url].each do |field|
    variants = entries.map { |entry| entry[field] }.uniq
    abort_sync("inconsistent #{field} for speaker #{code}") if variants.length > 1
  end

  first = entries.first
  {
    "code" => code,
    "name" => first.fetch("name"),
    "avatar" => first["avatar"],
    "biography" => first.fetch("biography"),
    "profile_url" => first.fetch("profile_url"),
    "sessions" => entries.map { |entry| entry.fetch("session") }.uniq { |session| session.fetch("url") }
  }
end.sort_by { |speaker| speaker.fetch("name").downcase }

duplicate_names = speakers.group_by { |speaker| speaker.fetch("name").downcase }.select { |_name, entries| entries.length > 1 }
abort_sync("duplicate speaker names with different IDs: #{duplicate_names.keys.join(', ')}") unless duplicate_names.empty?

agenda_output = "---\n#{YAML.dump(agenda).delete_prefix("---\n")}"
speakers_output = "#{JSON.pretty_generate(speakers)}\n"

root = File.expand_path("..", __dir__)
outputs = {
  File.join(root, "_data", "agenda.yml") => agenda_output,
  File.join(root, "_data", "speakers.json") => speakers_output
}

changes = outputs.select { |path, content| !File.exist?(path) || File.read(path) != content }

puts "Validated #{agenda['workshops'].length} workshops, #{conference_sessions.length} talks, and #{speakers.length} speakers."

if options[:check]
  if changes.empty?
    puts "Local Pretalx data is up to date."
    exit 0
  end

  warn "Pretalx data differs: #{changes.keys.map { |path| path.delete_prefix("#{root}/") }.join(', ')}"
  exit 1
end

changes.each do |path, content|
  directory = File.dirname(path)
  Tempfile.create(["pretalx-sync", ".tmp"], directory) do |file|
    file.write(content)
    file.flush
    file.fsync
    File.rename(file.path, path)
  end
  puts "Updated #{path.delete_prefix("#{root}/")}"
end

puts "No data changes." if changes.empty?
